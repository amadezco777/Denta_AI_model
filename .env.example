# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# Rutas de datos (por defecto, relativas a la raiz del repositorio).
# Cambialas si guardas los datasets en otro disco por espacio.
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

# Dispositivo de entrenamiento: "cpu", "0", "0,1", "mps"
DEVICE=cpu

# Semilla global para reproducibilidad
RANDOM_SEED=42
